# MozaPlay — Supabase/Lovable Cloud
# Ligação PostgreSQL usada pelo Drizzle para aplicar migrations no deploy.
# Não publicar o valor real no GitHub; configure-o como secret no Render.
LOVABLE_DB_MIGRATION_URL=COLOCA_A_DATABASE_URL_DE_MIGRATION_AQUI

SUPABASE_PROJECT_ID=COLOCA_O_PROJECT_ID
SUPABASE_URL=https://COLOCA_O_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=COLOCA_A_TUA_CHAVE_PUBLISHABLE_AQUI

VITE_SUPABASE_PROJECT_ID=COLOCA_O_PROJECT_ID
VITE_SUPABASE_URL=https://COLOCA_O_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=COLOCA_A_TUA_CHAVE_PUBLISHABLE_AQUI

# PAY.CO.MZ — apenas no servidor/Render
PAYMENT_PROVIDER=payco
PAYCO_API_URL=https://pay.co.mz/api/public/v1
PAYCO_API_KEY=COLOCA_A_CHAVE_PAYCO
PAYCO_MERCHANT_ID=COLOCA_O_MERCHANT_ID
PAYCO_WEBHOOK_SECRET=COLOCA_O_SEGREDO_DO_WEBHOOK
PAYCO_WALLET_ID_MPESA=COLOCA_O_WALLET_ID_MPESA
PAYCO_WALLET_ID_MKESH=
PAYCO_WALLET_ID_EMOLA=COLOCA_O_WALLET_ID_EMOLA

# Notificações web push — configurar apenas no servidor/Render.
VAPID_PUBLIC_KEY=COLOCA_A_CHAVE_PUBLICA_VAPID
VAPID_PRIVATE_KEY=COLOCA_A_CHAVE_PRIVADA_VAPID
VAPID_SUBJECT=mailto:suporte@mozaplay.co.mz

# O navegador pode receber a chave pública através do server function.
# Nunca publicar VAPID_PRIVATE_KEY no GitHub.

# Voz WebRTC — OpenRelay fallback
VITE_TURN_URL=turn:openrelay.metered.ca:80
VITE_TURN_USERNAME=openrelayproject
VITE_TURN_CREDENTIAL=openrelayproject

PAYCO_WALLET_ID_CARD=
